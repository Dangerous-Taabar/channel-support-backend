# ---- Server ----
PORT=3000
# Comma-separated list of origins allowed to call this API (your frontend URL / claude.ai artifact origin)
ALLOWED_ORIGINS=*

# ---- Secret used to sign/verify session tokens (any long random string) ----
SESSION_SECRET=change_this_to_a_long_random_string

# ---- Your public backend URL (used to build the callback link the shortlink redirects to) ----
PUBLIC_BASE_URL=https://your-backend.onrender.com

# ---- Shortlink provider (GPLinks example) ----
GPLINKS_API_KEY=your_gplinks_api_key
GPLINKS_API_URL=https://gplinks.in/api

# ---- Telegram Bot (for real admin verification) ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=@your_channel_username_or_-100xxxxxxxxxx

# Minimum seconds a user must spend between session-start and callback (basic anti-bypass)
MIN_DWELL_SECONDS=15

# ---- Support certificate (Silver / Gold / Platinum) ----
# Total supported days at which the tier changes (defaults shown)
CERT_GOLD_DAYS=30
CERT_PLATINUM_DAYS=75

# ---- Ludo (ASTRA bot Mini App) ----
# Token of the ASTRA bot (@AstraControlBot). Only used to check that players are real Telegram users.
# NOT the same as TELEGRAM_BOT_TOKEN above (that is the channel-support bot).
LUDO_BOT_TOKEN=123456:token-of-AstraControlBot
# A long random string. Put the SAME value in the ASTRA bot's .env as LUDO_BOT_SECRET
LUDO_BOT_SECRET=change-me-to-a-long-random-string
# Seconds each player gets per action before the server plays for them (default 30)
LUDO_TURN_SECONDS=30

# ---- (Optional) Support-card topic ----
# Easiest way: run /setsupporttopic inside the topic in your community group (no env needed).
# Or set the chat via TELEGRAM_NOTIFY_CHAT_ID (-100...) and the topic's id here:
TELEGRAM_NOTIFY_TOPIC_ID=
