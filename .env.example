# ---- Server ----
PORT=3000
# Comma-separated list of origins allowed to call this API (your frontend URL / claude.ai artifact origin)
ALLOWED_ORIGINS=*

# ---- Secret used to sign/verify session tokens (any long random string) ----
SESSION_SECRET=change_this_to_a_long_random_string

# ---- Your public backend URL (used to build the callback link the shortlink redirects to) ----
PUBLIC_BASE_URL=https://your-backend.onrender.com

# ---- Shortlink provider (GPLinks example) ----
GPLINKS_API_KEY=your_gplinks_api_key
GPLINKS_API_URL=https://gplinks.in/api

# ---- Telegram Bot (for real admin verification) ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=@your_channel_username_or_-100xxxxxxxxxx

# Minimum seconds a user must spend between session-start and callback (basic anti-bypass)
MIN_DWELL_SECONDS=15
